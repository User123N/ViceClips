{
  "name": "vice-clips",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first video clipping platform",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "npm run dev --workspace @vice/web",
    "worker": "npm run dev --workspace @vice/worker",
    "clip": "npm run clip --workspace @vice/worker --",
    "build": "npm run build --workspace @vice/web",
    "lint": "npm run lint --workspace @vice/web",
    "typecheck": "npm run typecheck --workspace @vice/web"
  },
  "engines": { "node": ">=20.0.0" }
}